{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavola",
  "version": "0.1.0",
  "identifier": "org.borck.tavola",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tavola",
        "width": 1180,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "GraphicsAndDesign",
    "shortDescription": "One source, one designed infographic.",
    "longDescription": "Turn one document into one designed infographic. Privacy-first, local-first, bring your own model. Export PNG, PDF, or editable HTML.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
